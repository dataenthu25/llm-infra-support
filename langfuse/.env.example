# Copy to langfuse/.env (not the project root .env) and replace every CHANGEME.
# Generate random values with:  openssl rand -hex 32
# Do not quote values: Compose passes the quotes through to Langfuse.

# --- Secrets marked "# CHANGEME" in docker-compose.yml ---
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
# Must be exactly 64 hex characters (openssl rand -hex 32).
ENCRYPTION_KEY=CHANGEME

# The password must be the same in both lines.
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres

CLICKHOUSE_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME

# MinIO's root password is the S3 secret key Langfuse uses, so all four must be the same.
MINIO_ROOT_PASSWORD=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME

# --- Headless initialization: created on first start if they don't exist ---
# https://langfuse.com/self-hosting/administration/headless-initialization
LANGFUSE_INIT_ORG_ID=opspilot
LANGFUSE_INIT_ORG_NAME=opspilot
LANGFUSE_INIT_PROJECT_ID=opspilot
LANGFUSE_INIT_PROJECT_NAME=opspilot
# Put the same two keys in the project root .env as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-opspilot-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
# Login for http://localhost:3000
LANGFUSE_INIT_USER_EMAIL=admin@opspilot.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
